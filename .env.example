# Supabase project for iRABU (create your own — do not reuse another project)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic — powers the assistant chat and answer synthesis
ANTHROPIC_API_KEY=

# Voyage — used for voyage-3.5 (knowledge chunk embeddings, 1024-dim)
VOYAGE_API_KEY=

# Public app URL (used for auth redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Resend — sends meeting invite/cancellation emails with a calendar attachment.
# Optional: without it, meetings still work, invites just don't get emailed.
RESEND_API_KEY=
RESEND_FROM=iRABU <onboarding@resend.dev>

# Nessie — Capital One's sandbox banking API, powers the Finance feature.
# Free instant signup at http://api.nessieisreal.com. Optional: without it,
# workspaces just see "not configured" instead of a connect button.
NESSIE_API_KEY=

# ElevenLabs — voice input (speech-to-text) and spoken replies (text-to-speech)
# in Chat. Optional: without it, the mic button just shows an error.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Solana devnet — sponsored credits (see docs/sponsored-credits.md).
# SOLANA_TREASURY_KEYPAIR is a base58-encoded secret key for a devnet-only
# keypair — generate a fresh one, never reuse a mainnet key. It both funds
# orgs (stand-in for a sponsor's wallet) and signs settlement memos, so it
# needs a devnet SOL balance to pay tx fees and to fund with — request some
# at https://faucet.solana.com. Optional: without it, usage still tracks in
# the database, funding/settlement just stay pending.
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_TREASURY_KEYPAIR=
LAMPORTS_PER_CREDIT=500000

# Backboard.io — cross-session chat memory (see docs/backboard-memory.md).
# One Backboard assistant is created per organization on first chat message.
# Optional: without it, chat works exactly as before, just with no memory
# across conversations.
BACKBOARD_API_KEY=

# Bearer secret for the external settlement-sweep timer running on Vultr
# (see docs/solana-settlement-worker.md). Optional: without it the route
# just always 401s and chat-triggered settlement keeps working as before.
CRON_SECRET=

# Persona — identity verification gating access to sensitive knowledge
# sources (see docs/verified-access.md). Optional: without PERSONA_API_KEY
# the verify route always 502s and nothing can ever pass the gate, so
# requires_verification sources just stay unreadable to everyone.
PERSONA_API_KEY=
NEXT_PUBLIC_PERSONA_TEMPLATE_ID=
NEXT_PUBLIC_PERSONA_ENVIRONMENT_ID=
