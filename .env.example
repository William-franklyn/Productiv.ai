# Supabase project for ProductivAI (create your own — do not reuse another project)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic — powers the assistant chat and answer synthesis
ANTHROPIC_API_KEY=

# Voyage — used for voyage-3.5 (knowledge chunk embeddings, 1024-dim)
VOYAGE_API_KEY=

# Public app URL (used for auth redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Resend — sends meeting invite/cancellation emails with a calendar attachment.
# Optional: without it, meetings still work, invites just don't get emailed.
RESEND_API_KEY=
RESEND_FROM=ProductivAI <onboarding@resend.dev>

# Nessie — Capital One's sandbox banking API, powers the Finance feature.
# Free instant signup at http://api.nessieisreal.com. Optional: without it,
# workspaces just see "not configured" instead of a connect button.
NESSIE_API_KEY=

# ElevenLabs — voice input (speech-to-text) and spoken replies (text-to-speech)
# in Chat. Optional: without it, the mic button just shows an error.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
